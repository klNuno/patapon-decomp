# Pinned toolchain. Bumping a value needs the maintainer's go, then `tools/setup.sh --lock`.
# Debian 13 cross binutils (GNU as knows -march=allegrex; VFPU words go through psp-decomp-tools' assemble.py)
BINUTILS_DEB=pool/main/b/binutils-mipsen/binutils-mipsel-linux-gnu_2.44-3cross1+nmu1+b1_amd64.deb
# decomp.me compiler kits (github.com/decompme/compilers, release "compilers"): Sony psp-gcc 3.x kits and SN Systems SNC
DECOMPME_KITS="psp-gcc-1.3.1 psp-gcc-1.7.1 pspsnc_1.2.7503.0"
# Metrowerks CodeWarrior PSP kits from the same release, fallbacks if neither psp-gcc nor SNC fits (Windows, run by wibo)
MWCCPSP_KITS="mwccpsp_3.0.1_121 mwccpsp_3.0.1_134 mwccpsp_3.0.1_139 mwccpsp_3.0.1_147 mwccpsp_3.0.1_151 mwccpsp_3.0.1_180 mwccpsp_3.0.1_192 mwccpsp_3.0.1_201 mwccpsp_3.0.1_205 mwccpsp_3.0.1_210 mwccpsp_3.0.1_219"
# wibo (MIT): runs the Windows compilers (pspsnc.exe, mwccpsp.exe) on Linux
WIBO_TAG=1.2.0
OBJDIFF_TAG=v3.8.3
# Shared PSP decomp tooling (CC0-1.0): prx.py, assemble.py, compiler_probe.py, nids.txt
PSP_DECOMP_TOOLS_REV=5e5fa8e3472a96d3258a58bfc49e872537455c92
M2C_REV=708d2d2cb2698f091a92492b328f73b24209f72d
PERMUTER_REV=8556c81d80d1c1af98a858c8f4dc951357f29139
ASM_DIFFER_REV=0dd09af8f8008f1f880327cf0aca3b26d2562ea2
# The psp-gcc kits are 32-bit x86 Linux programs: Debian 13's i386 libc runs them with no multiarch install
LIBC6_I386_DEB=pool/main/g/glibc/libc6_2.41-12+deb13u4_i386.deb
